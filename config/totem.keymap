#define HOST_OS                    2
#define ZMK_HELPERS_KEEP_NATIVE    0

#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi>
#include <dt-bindings/zmk/keys.h>
#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/totem.h"
// #include "zmk-helpers/unicode-chars/italian.dtsi"

#define ______ &trans
#define XXXXXX &none

#define DEF   0
#define NAV   1
#define NUM   2
#define SYM   3
#define FUN   4
#define LH    5
#define ACC   6
#define SEL   7
#define TSEL  8

/* Timing constants */

#define HOMEROW_TAP_MS    280
#define TDANCE_TAP_MS     200
#define QUICK_TAP_MS      175
#define PRIOR_IDLE_MS     150

/* Timeless homerow mods */
// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
#define THUMBS LH0 LH1 LH2 RH0 RH1 RH2  // thumbs

ZMK_HOLD_TAP(hml,
    flavor = "balanced";
    tapping-term-ms = <HOMEROW_TAP_MS>;
    require-prior-idle-ms = <PRIOR_IDLE_MS>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;
    bindings = <&kp>, <&kp>;
)

ZMK_HOLD_TAP(hmr,
    flavor = "balanced";
    tapping-term-ms = <HOMEROW_TAP_MS>;
    require-prior-idle-ms = <PRIOR_IDLE_MS>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
    bindings = <&kp>, < &kp >;
)

ZMK_HOLD_TAP(qlt,
    flavor = "balanced";
    tapping-term-ms = <175>;
    bindings = <&mo>, <&kp>;
    quick-tap-ms = <QUICK_TAP_MS>;
    display-name = "Quick Layer-Tap";
)

// tap: backspace | shift + tap: delete | hold: num layer
ZMK_MOD_MORPH(bs_del_sym,
    bindings = <&qlt SYM BSPC>, <&kp DEL>;
mods = <(MOD_LSFT | MOD_RSFT)>;
)

// tap: shift | double-tap: caps word
ZMK_TAP_DANCE(LS_caps,
    tapping-term-ms = <TDANCE_TAP_MS>;
    bindings = <&kp LSHIFT>, <&caps_word>;
)

// Accented vowels via macOS Option dead keys (Opt+` = grave, Opt+E = acute).
// Each key types the finished letter; with Shift held it types the capital.
#define ACCENT(name, dead, vowel) \
    ZMK_MACRO(name##_lo, wait-ms = <0>; tap-ms = <20>; bindings = <&kp dead>, <&kp vowel>;) \
    ZMK_MACRO(name##_up, wait-ms = <0>; tap-ms = <20>; bindings = <&kp dead>, <&kp LS(vowel)>;) \
    ZMK_MOD_MORPH(name, bindings = <&name##_lo>, <&name##_up>; mods = <(MOD_LSFT | MOD_RSFT)>;)

ACCENT(a_grave, LA(GRAVE), A)  // à À
ACCENT(e_grave, LA(GRAVE), E)  // è È
ACCENT(e_acute, LA(E),     E)  // é É
ACCENT(i_grave, LA(GRAVE), I)  // ì Ì
ACCENT(o_grave, LA(GRAVE), O)  // ò Ò
ACCENT(u_grave, LA(GRAVE), U)  // ù Ù

// Select layer actions: do the thing, then return to base
#define SEL_EXIT(name, key) \
    ZMK_MACRO(name, wait-ms = <0>; tap-ms = <20>; bindings = <&kp key>, <&to DEF>;)

SEL_EXIT(sel_copy,  LG(C))
SEL_EXIT(sel_cut,   LG(X))
SEL_EXIT(sel_paste, LG(V))
SEL_EXIT(sel_del,   BSPC)

// Terminal select: cmux copy mode (Vim keys) with the same layout as the Select layer
ZMK_MACRO(term_on,   wait-ms = <0>; tap-ms = <20>; bindings = <&kp LG(LS(M))>, <&to TSEL>;)
ZMK_MACRO(term_copy, wait-ms = <0>; tap-ms = <20>; bindings = <&kp Y>, <&to DEF>;)
ZMK_MACRO(term_esc,  wait-ms = <0>; tap-ms = <20>; bindings = <&kp ESC>, <&to DEF>;)
ZMK_MACRO(vim_top,   wait-ms = <0>; tap-ms = <20>; bindings = <&kp G>, <&kp G>;)

// Claude Code: double Esc (rewind). The Esc key's own double-tap toggles LH instead.
ZMK_MACRO(esc_esc,
    wait-ms = <30>;
    tap-ms = <20>;
    bindings = <&kp ESC>, <&kp ESC>;
)

// Tap: num-word | double-tap: sticky num-layer | Hold: num-layer.
#define SMART_NUM &smart_num NUM 0
ZMK_HOLD_TAP(smart_num, bindings = <&mo>, <&num_dance>; flavor = "balanced";
             tapping-term-ms = <TDANCE_TAP_MS>; quick-tap-ms = <QUICK_TAP_MS>;)
ZMK_TAP_DANCE(num_dance, bindings = <&num_word NUM>, <&sl NUM>;
              tapping-term-ms = <TDANCE_TAP_MS>;)

ZMK_COMBO(smart_num,  SMART_NUM,     RB0 RB1, NUM)  // smart_num, active on base
ZMK_COMBO(copy,       &kp LG(C),     LT0 LT1, ALL)  // copy, active on all layers
ZMK_COMBO(cut,        &kp LG(X),     LT2 LM2, ALL)  // cut, active on all layers
ZMK_COMBO(paste,      &kp LG(V),     LT1 LM1, ALL)  // paste, active on all layers
ZMK_COMBO(clipboard,  &kp LA(LG(C)), LT3 LM3, ALL)  // clipboard, active on all layers
ZMK_COMBO(spotlight,  &kp LG(SPACE), RM0 RM1, DEF)  // spotlight, active on base
ZMK_COMBO(vscode_cmd, &kp LS(LG(P)), LM0 LM1, DEF)  // vscode command palette, active on base
ZMK_COMBO(undo,       &kp LG(Z),     LT0 LM0, DEF LH)  // undo, active on base
ZMK_COMBO(redo,       &kp LG(LS(Z)), LB0 LM0, DEF LH)  // redo, active on base
ZMK_COMBO(undo_2,     &kp LG(Z),     RT0 RM0, DEF)  // undo, active on base
ZMK_COMBO(redo_2,     &kp LG(LS(Z)), RB0 RM0, DEF)  // redo, active on base
ZMK_COMBO(next_win,   &kp LG(GRAVE), LM1 LB1, DEF LH)  // next window, active on base
ZMK_COMBO(save,       &kp LG(S), LM3 LB3, DEF LH)  // save, active on base
ZMK_COMBO(screenshot, &kp LS(LG(N4)), LM2 LB2, DEF LH)  // area screenshot (Shottr owns Cmd+Shift+4)

// tap J+M, then a vowel: à è ì ò ù, and D (under E) for é
ZMK_COMBO(accents,    &sl ACC,   RB1 RM1, DEF)

ZMK_TAP_DANCE(ESC_LH,
    tapping-term-ms = <TDANCE_TAP_MS>;
    bindings = <&kp ESC>, <&tog LH>;
)

// select current line: jump to line start, then shift-select to line end
ZMK_MACRO(sel_line,
    wait-ms = <0>;
    tap-ms = <20>;
    bindings = <&kp LG(LEFT)>, <&kp LS(LG(RIGHT))>;
)

&num_word {
  continue-list = <BACKSPACE DELETE DOT COMMA PLUS MINUS STAR FSLH EQUAL SPACE LT GT DLLR COLON>;
};


/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
         &kp Q         &kp W        &kp E         &kp R         &kp T              &kp Y          &kp U        &kp I              &kp O        &kp P
         &hml LCTRL A  &hml LALT S  &hml LSHFT D  &hml LGUI F   &kp G              &kp H          &hmr RGUI J  &hmr RSHFT K       &hmr RALT L  &hmr RCTRL SEMI
&ESC_LH  &kp Z         &kp X        &kp C         &kp V         &kp B              &kp N          &kp M        &kp COMMA          &kp DOT      &kp SLASH        &kp APOS
                                    &LS_caps      &qlt NUM TAB  &kp SPACE          &lt NAV ENTER  &bs_del_sym  &qlt FUN RC(GRAVE)
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
        // left hand = cmux / Claude Code
        //   W/E prev/next workspace   R jump to unread   T notifications
        //   Z Esc Esc   X Shift+Tab (Claude mode)   C Ctrl+V (paste image)   V zoom pane
        //   G Select layer (Nav with Shift locked on)
        ______     &kp LG(LC(LBKT))  &kp LG(LC(RBKT))  &kp LG(LS(U))   &kp LG(I)          &kp LG(LEFT)  &kp PG_DN     &kp PG_UP   &kp LG(RIGHT)  &sel_line
        &kp LCTRL  &kp LALT          &kp LSHFT         &kp LGUI        &to SEL            &kp LEFT      &kp DOWN      &kp UP      &kp RIGHT      ______
______  &esc_esc   &kp LS(TAB)       &kp LC(V)         &kp LG(LS(RET)) ______             &kp LA(LEFT)  &kp LA(DOWN)  &kp LA(UP)  &kp LA(RIGHT)  ______  ______
                             ______     ______      &kp SPACE     ______        ______        ______
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
         &kp STAR  &kp N1  &kp N2  &kp N3   &kp PLUS       ______  ______    ______     ______    ______
         &kp FSLH  &kp N4  &kp N5  &kp N6   &kp MINUS      ______  &kp RGUI  &kp RSHFT  &kp RALT  &kp RCTRL
&kp DOT  &kp N0    &kp N7  &kp N8  &kp N9   &kp EQUAL      ______  ______    ______     ______    ______     ______
                               ______  ______  ______      ______  ______    ______
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
        &kp STAR   &kp  AT           &kp DLLR         &kp LS(POUND)    &kp DQT           &kp EQUAL  &kp LBRC        &kp LBKT         &kp LPAR        &kp PIPE
        &kp LCTRL  &hml LALT LA(N3)  &hml LSHFT EXCL  &hml LGUI PRCNT  &kp COLON         &kp MINUS  &hmr RGUI RBRC  &hmr RSHFT RBKT  &hmr RALT RPAR  &hmr RCTRL TILDE
______  ______     &kp  PLUS         &kp FSLH         &kp BSLH         &kp AMPS          &kp UNDER  &kp QMARK       &kp LT           &kp GT          &kp CARET         &kp GRAVE
                                     ______           ______           &kp SPACE         ______     ______          ______
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
                &bootloader  &kp F1  &kp F2   &kp F3   &kp F4       &kp C_VOL_UP  &kp C_VOL_DN  &kp C_MUTE  ______  &kp C_POWER
                ______       &kp F5  &kp F6   &kp F7   &kp F8       &kp C_PREV    &kp C_PP      &kp C_NEXT  ______  &kp C_AL_LOCK
&studio_unlock  ______       &kp F9  &kp F10  &kp F11  &kp F12      &kp C_BRI_UP  &kp C_BRI_DN  ______      ______  &kp K_CANCEL   ______
                                     ______   ______   ______       ______        ______        ______
            >;
        };

        lh_layer {
            display-name = "LH";
            bindings = <
        ______     &kp LG(W) ______     ______         ______         ______  ______  ______  ______  ______
        &kp LCTRL  &kp LALT &kp LSHFT  &kp LGUI       ______         ______  ______  ______  ______  ______
______  ______   &kp LG(A)  ______    ______          &kp ENTER         ______  ______  ______  ______  ______  ______
                             &kp TAB   &qlt NUM BSPC  &kp SPACE      ______  ______  ______
            >;
        };

        acc_layer {
            display-name = "Acc";
            bindings = <
        ______    ______  &e_grave  ______  ______        ______  &u_grave  &i_grave  &o_grave  ______
        &a_grave  ______  &e_acute  ______  ______        ______  ______    ______    ______    ______
______  ______    ______  ______    ______  ______        ______  ______    ______    ______    ______  ______
                          ______    ______  ______        ______  ______    ______
            >;
        };

        // Nav with Shift locked on, entered from Nav G. Same positions as Nav, but every move selects.
        // C copy, X cut, V paste over, Backspace delete: each does it and returns to base.
        // Esc or Space just returns to base. Other keys do nothing, so you can't type by accident.
        // T switches to Terminal select (cmux copy mode).
        select_layer {
            display-name = "Select";
            bindings = <
            XXXXXX  XXXXXX    XXXXXX     XXXXXX     &term_on      &kp LS(LG(LEFT))  &kp LS(LG(DOWN))  &kp LS(LG(UP))  &kp LS(LG(RIGHT))  &sel_line
            XXXXXX  XXXXXX    XXXXXX     XXXXXX     XXXXXX        &kp LS(LEFT)      &kp LS(DOWN)      &kp LS(UP)      &kp LS(RIGHT)      &kp LG(A)
&to DEF     XXXXXX  &sel_cut  &sel_copy  &sel_paste  XXXXXX        &kp LS(LA(LEFT))  &kp LS(LA(DOWN))  &kp LS(LA(UP))  &kp LS(LA(RIGHT))  XXXXXX  XXXXXX
                              XXXXXX     XXXXXX     &to DEF       XXXXXX            &sel_del          XXXXXX
            >;
        };

        // Terminal select: cmux copy mode, same positions as Select. Move to the start, F starts/stops
        // selecting, C copies and returns to base, Esc or Space cancels.
        term_select_layer {
            display-name = "TermSel";
            bindings = <
            XXXXXX  XXXXXX  XXXXXX      XXXXXX  XXXXXX        &kp N0    &kp LS(G)  &vim_top  &kp DLLR   &kp LS(V)
            XXXXXX  XXXXXX  XXXXXX      &kp V   XXXXXX        &kp LEFT  &kp DOWN   &kp UP    &kp RIGHT  XXXXXX
&term_esc   XXXXXX  XXXXXX  &term_copy  XXXXXX  XXXXXX        &kp B     XXXXXX     XXXXXX    &kp W      XXXXXX  XXXXXX
                            XXXXXX      XXXXXX  &term_esc     XXXXXX    XXXXXX     XXXXXX
            >;
        };
    };
};
